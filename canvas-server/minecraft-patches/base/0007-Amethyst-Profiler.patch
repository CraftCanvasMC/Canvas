diff --git a/io/papermc/paper/threadedregions/TickRegionScheduler.java b/io/papermc/paper/threadedregions/TickRegionScheduler.java
index edc41807539f02299264ffdbacf2c47bca355389..aba6ad60017db94d19a70366cf692dd073b72e25 100644
--- a/io/papermc/paper/threadedregions/TickRegionScheduler.java
+++ b/io/papermc/paper/threadedregions/TickRegionScheduler.java
@@ -451,6 +451,23 @@ public final class TickRegionScheduler {
 
         @Override
         public final boolean runTasks(final BooleanSupplier canContinue) {
+        // Canvas start - amethyst profiler
+            final io.canvasmc.amethyst.hooks.HookSession amethyst = io.canvasmc.amethyst.hooks.ProfilerHooks.active();
+            if (amethyst == null) {
+                return this.internal$runTasks(canContinue);
+            }
+
+            final long start = System.nanoTime();
+            io.canvasmc.canvas.profiler.RegionHooks.tasksStart(amethyst, this, start);
+            try {
+                return this.internal$runTasks(canContinue);
+            } finally {
+                io.canvasmc.canvas.profiler.RegionHooks.tasksEnd(amethyst, this, start, System.nanoTime());
+            }
+        }
+
+        private boolean internal$runTasks(final BooleanSupplier canContinue) {
+        // Canvas end - amethyst profiler
             if (this.cancelled.get()) {
                 return false;
             }
@@ -506,6 +523,22 @@ public final class TickRegionScheduler {
 
         @Override
         public final boolean runTick() {
+        // Canvas start - amethyst profiler
+            final io.canvasmc.amethyst.hooks.HookSession amethyst = io.canvasmc.amethyst.hooks.ProfilerHooks.active();
+            if (amethyst == null) {
+                return this.internal$runTick();
+            }
+
+            io.canvasmc.canvas.profiler.RegionHooks.tickStart(amethyst, this, System.nanoTime());
+            try {
+                return this.internal$runTick();
+            } finally {
+                io.canvasmc.canvas.profiler.RegionHooks.tickEnd(amethyst, this, System.nanoTime());
+            }
+        }
+
+        private boolean internal$runTick() {
+        // Canvas end - amethyst profiler
             // Remember, we are supposed use setScheduledStart if we return true here, otherwise
             // the scheduler will try to schedule for the same time.
             if (this.cancelled.get()) {
