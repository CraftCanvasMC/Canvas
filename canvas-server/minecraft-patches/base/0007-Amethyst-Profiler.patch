Subject: [PATCH] Amethyst Profiler


diff --git a/io/canvasmc/canvas/profiler/CanvasPlatform.java b/io/canvasmc/canvas/profiler/CanvasPlatform.java
new file mode 100644
index 0000000000000000000000000000000000000000..3ad99749d3035338eefc22ea305c2637ced24a2a
--- /dev/null
+++ b/io/canvasmc/canvas/profiler/CanvasPlatform.java
@@ -0,0 +1,33 @@
+package io.canvasmc.canvas.profiler;
+
+import io.canvasmc.amethyst.PlatformImplementation;
+import io.canvasmc.amethyst.source.SourceResolver;
+import io.papermc.paper.ServerBuildInfo;
+import io.papermc.paper.ServerBuildInfoImpl;
+import java.util.List;
+
+public class CanvasPlatform implements PlatformImplementation {
+    private static final ServerBuildInfoImpl BUILD_INF = (ServerBuildInfoImpl) ServerBuildInfo.buildInfo();
+
+    @Override
+    public String getPlatformVer() {
+        return BUILD_INF.minecraftVersionName();
+    }
+
+    @Override
+    public String getPlatformName() {
+        return BUILD_INF.brandName();
+    }
+
+    @Override
+    public List<String> getPlatformAuthors() {
+        // TODO - should we implement a better way?
+        return List.of(getPlatformName() + " Team");
+    }
+
+    @Override
+    public SourceResolver getResolver() {
+        // TODO - make proper source resolver
+        return SourceResolver.INTERNALS_ONLY;
+    }
+}
diff --git a/io/canvasmc/canvas/profiler/package-info.java b/io/canvasmc/canvas/profiler/package-info.java
new file mode 100644
index 0000000000000000000000000000000000000000..cfb1c5e1a8b73a6a301eb171c55d31242f861d1b
--- /dev/null
+++ b/io/canvasmc/canvas/profiler/package-info.java
@@ -0,0 +1,4 @@
+@NullMarked
+package io.canvasmc.canvas.profiler;
+
+import org.jspecify.annotations.NullMarked;
diff --git a/net/minecraft/server/Bootstrap.java b/net/minecraft/server/Bootstrap.java
index d3ac1fa9ee37079f575ab8004f629f8231f08628..58356b9339a40877ae30bf01fb98841a4e7222cf 100644
--- a/net/minecraft/server/Bootstrap.java
+++ b/net/minecraft/server/Bootstrap.java
@@ -44,6 +44,7 @@ public class Bootstrap {
         if (!isBootstrapped) {
             isBootstrapped = true;
             Instant start = Instant.now();
+            io.canvasmc.amethyst.PlatformImplementation.set(new io.canvasmc.canvas.profiler.CanvasPlatform()); // Canvas - amethyst profiler
             io.papermc.paper.plugin.entrypoint.LaunchEntryPointHandler.enterBootstrappers(); // Paper - Entrypoint for bootstrapping
             if (BuiltInRegistries.REGISTRY.keySet().isEmpty()) {
                 throw new IllegalStateException("Unable to load registries");
