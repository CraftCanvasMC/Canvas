--- /dev/null
+++ b/io/canvasmc/canvas/profiler/CanvasPlatform.java
@@ -0,0 +1,33 @@
+package io.canvasmc.canvas.profiler;
+
+import io.canvasmc.amethyst.PlatformImplementation;
+import io.canvasmc.amethyst.source.SourceResolver;
+import io.papermc.paper.ServerBuildInfo;
+import io.papermc.paper.ServerBuildInfoImpl;
+import java.util.List;
+
+public class CanvasPlatform implements PlatformImplementation {
+    private static final ServerBuildInfoImpl BUILD_INF = (ServerBuildInfoImpl) ServerBuildInfo.buildInfo();
+
+    @Override
+    public String getPlatformVer() {
+        return BUILD_INF.minecraftVersionName();
+    }
+
+    @Override
+    public String getPlatformName() {
+        return BUILD_INF.brandName();
+    }
+
+    @Override
+    public List<String> getPlatformAuthors() {
+        // TODO - should we implement a better way?
+        return List.of(getPlatformName() + " Team");
+    }
+
+    @Override
+    public SourceResolver getResolver() {
+        // TODO - make proper source resolver
+        return SourceResolver.INTERNALS_ONLY;
+    }
+}
diff --git a/io/canvasmc/canvas/profiler/RegionHooks.java b/io/canvasmc/canvas/profiler/RegionHooks.java
new file mode 100644
index 0000000000000000000000000000000000000000..6db2c0f7c7f4832119901c8e93a7a24f930d5d69
--- /dev/null
+++ b/io/canvasmc/canvas/profiler/RegionHooks.java
@@ -0,0 +1,192 @@
+package io.canvasmc.canvas.profiler;
+
+import io.canvasmc.amethyst.hooks.HookSession;
+import io.canvasmc.amethyst.hooks.ProfilerHooks;
+import io.canvasmc.amethyst.timeline.TimelineRecorder;
+import io.canvasmc.canvas.util.Util;
+import io.papermc.paper.threadedregions.ThreadedRegionizer;
+import io.papermc.paper.threadedregions.TickRegionScheduler;
+import io.papermc.paper.threadedregions.TickRegions;
+import it.unimi.dsi.fastutil.longs.LongOpenHashSet;
+import it.unimi.dsi.fastutil.objects.Object2LongOpenHashMap;
+import java.util.List;
+import it.unimi.dsi.fastutil.objects.ObjectArrayList;
+import net.minecraft.server.MinecraftServer;
+import net.minecraft.server.level.ServerLevel;
+import org.jspecify.annotations.Nullable;
+
+public final class RegionHooks {
+
+    private RegionHooks() {
+    }
+
+    public static long handle(final ThreadedRegionizer.ThreadedRegion<TickRegions.TickRegionData, TickRegions.TickRegionSectionData> region) {
+        return region.getData().id;
+    }
+
+    public static void created(final ThreadedRegionizer.ThreadedRegion<TickRegions.TickRegionData, TickRegions.TickRegionSectionData> region) {
+        final HookSession session = ProfilerHooks.active();
+        if (session != null) {
+            session.timeline().created(world(region.getData().world), handle(region), region.getOwnedSections().toLongArray());
+        }
+    }
+
+    public static void destroyed(final ThreadedRegionizer.ThreadedRegion<TickRegions.TickRegionData, TickRegions.TickRegionSectionData> region) {
+        final HookSession session = ProfilerHooks.active();
+        if (session != null) {
+            session.timeline().destroyed(world(region.getData().world), handle(region));
+        }
+    }
+
+    public static void active(final ThreadedRegionizer.ThreadedRegion<TickRegions.TickRegionData, TickRegions.TickRegionSectionData> region) {
+        final HookSession session = ProfilerHooks.active();
+        if (session != null) {
+            session.timeline().active(world(region.getData().world), handle(region));
+        }
+    }
+
+    public static void inactive(final ThreadedRegionizer.ThreadedRegion<TickRegions.TickRegionData, TickRegions.TickRegionSectionData> region) {
+        final HookSession session = ProfilerHooks.active();
+        if (session != null) {
+            session.timeline().inactive(world(region.getData().world), handle(region));
+        }
+    }
+
+    public static void merged(
+        final ThreadedRegionizer.ThreadedRegion<TickRegions.TickRegionData, TickRegions.TickRegionSectionData> from,
+        final ThreadedRegionizer.ThreadedRegion<TickRegions.TickRegionData, TickRegions.TickRegionSectionData> into
+    ) {
+        final HookSession session = ProfilerHooks.active();
+        if (session == null) {
+            return;
+        }
+
+        final LongOpenHashSet survivor = new LongOpenHashSet(into.getOwnedSections());
+        survivor.addAll(from.getOwnedSections());
+
+        session.timeline().merged(
+            world(into.getData().world),
+            handle(from),
+            handle(into),
+            survivor.toLongArray()
+        );
+    }
+
+    public static void split(
+        final ThreadedRegionizer.ThreadedRegion<TickRegions.TickRegionData, TickRegions.TickRegionSectionData> from,
+        final List<ThreadedRegionizer.ThreadedRegion<TickRegions.TickRegionData, TickRegions.TickRegionSectionData>> into
+    ) {
+        final HookSession session = ProfilerHooks.active();
+        if (session == null) {
+            return;
+        }
+
+        final long[] handles = new long[into.size()];
+        for (int i = 0; i < handles.length; i++) {
+            handles[i] = handle(into.get(i));
+        }
+
+        session.timeline().split(world(from.getData().world), handle(from), handles);
+    }
+
+    public static void globalTick(final List<ServerLevel> worlds) {
+        final HookSession session = ProfilerHooks.active();
+        if (session == null || !session.snapshotDue(System.nanoTime())) {
+            return;
+        }
+
+        int regionCount = 0;
+        for (final ServerLevel level : worlds) {
+            final List<ThreadedRegionizer.ThreadedRegion<TickRegions.TickRegionData, TickRegions.TickRegionSectionData>>
+                live = new ObjectArrayList<>();
+            level.regioniser.computeForAllRegionsUnsynchronised(live::add);
+
+            final List<TimelineRecorder.Region> regions = new ObjectArrayList<>(live.size());
+            for (final ThreadedRegionizer.ThreadedRegion<TickRegions.TickRegionData, TickRegions.TickRegionSectionData> region : live) {
+                final long[] sections = region.getOwnedSections().toLongArray();
+                if (sections.length == 0) {
+                    // died after we listed it
+                    continue;
+                }
+
+                // updated by the owning region, safe to read from any thread
+                final TickRegions.RegionStats stats = region.getData().getRegionStats();
+                final Object2LongOpenHashMap<String> metrics = new Object2LongOpenHashMap<>(3);
+
+                metrics.put("chunks", stats.getChunkCount());
+                metrics.put("entities", stats.getEntityCount());
+                metrics.put("players", stats.getPlayerCount());
+
+                regions.add(new TimelineRecorder.Region(handle(region), sections, metrics));
+            }
+
+            regionCount += regions.size();
+            session.timeline().snapshot(world(level), regions);
+        }
+
+        final Object2LongOpenHashMap<String> global = new Object2LongOpenHashMap<>(3);
+        global.put("players", MinecraftServer.getServer().getPlayerCount());
+        global.put("regions", regionCount);
+        global.put("worlds", worlds.size());
+        session.timeline().globalMetrics(global);
+    }
+
+    public static void tickStart(
+        @Nullable
+        final HookSession session,
+        final TickRegionScheduler.RegionScheduleHandle handle,
+        final long nanoTime
+    ) {
+        if (session != null) {
+            session.tickStart(handle(handle), world(handle), nanoTime);
+        }
+    }
+
+    public static void tickEnd(
+        @Nullable
+        final HookSession session,
+        final TickRegionScheduler.RegionScheduleHandle handle,
+        final long nanoTime
+    ) {
+        if (session != null) {
+            session.tickEnd(handle(handle), world(handle), nanoTime);
+        }
+    }
+
+    public static void tasksStart(
+        @Nullable
+        final HookSession session,
+        final TickRegionScheduler.RegionScheduleHandle handle,
+        final long nanoTime
+    ) {
+        if (session != null) {
+            session.tasksStart(handle(handle), nanoTime);
+        }
+    }
+
+    public static void tasksEnd(
+        @Nullable
+        final HookSession session,
+        final TickRegionScheduler.RegionScheduleHandle handle,
+        final long startNanoTime,
+        final long endNanoTime
+    ) {
+        if (session != null) {
+            session.tasksEnd(handle(handle), world(handle), startNanoTime, endNanoTime);
+        }
+    }
+
+    // the global tick has no region
+    private static long handle(final TickRegionScheduler.RegionScheduleHandle handle) {
+        return handle.region == null ? 0L : handle(handle.region.region);
+    }
+
+    @Nullable
+    private static String world(final TickRegionScheduler.RegionScheduleHandle handle) {
+        return handle.region == null ? null : world(handle.region.world);
+    }
+
+    private static String world(final ServerLevel level) {
+        return Util.getLevelName(level);
+    }
+}
