+    // Canvas start - skip physics for resting items
+    private void updateRestingState() {
+        if (!this.level().isClientSide() && this.level().canvasConfig().entities.itemEntities.skipPhysicsForRestingItems
+            && this.onGround() && this.mainSupportingBlockPos.isPresent() && !this.isInWater() && !this.isInLava()) {
+            this.restX = this.getX();
+            this.restY = this.getY();
