+        } else {
+            this.restX = Double.NaN;
+        }
+    }
+
+    // still where it settled, not pushed, and every block it touches unchanged, so moving it would do nothing
+    private boolean isResting() {
+        if (Double.isNaN(this.restX)) {
+            return false;
+        }
+
+        final Vec3 movement = this.getDeltaMovement();
+        if (!this.level().canvasConfig().entities.itemEntities.skipPhysicsForRestingItems
+            || !this.onGround() || this.noPhysics || movement.y > 0.0D || movement.horizontalDistanceSqr() > 1.0E-5F
+            || this.getX() != this.restX || this.getY() != this.restY || this.getZ() != this.restZ
+            || this.isInWater() || this.isInLava() || this.touchingBlocksHash() != this.restBlocksHash) {
+            this.restX = Double.NaN;
+            return false;
+        }
+
+        return true;
+    }
+
+    private int touchingBlocksHash() {
+        final net.minecraft.world.phys.AABB box = this.getBoundingBox();
+        final int minX = Mth.floor(box.minX);
+        final int maxX = Mth.floor(box.maxX);
+        final int minY = Mth.floor(box.minY - 1.0E-6D);
+        final int maxY = Mth.floor(box.maxY);
+        final int minZ = Mth.floor(box.minZ);
+        final int maxZ = Mth.floor(box.maxZ);
+        final BlockPos.MutableBlockPos pos = new BlockPos.MutableBlockPos();
+        final Level level = this.level();
+        int hash = 1;
+        for (int x = minX; x <= maxX; x++) {
+            for (int y = minY; y <= maxY; y++) {
+                for (int z = minZ; z <= maxZ; z++) {
+                    hash = 31 * hash + System.identityHashCode(level.getBlockState(pos.set(x, y, z)));
+                }
+            }
+        }
+
+        return hash;
+    }
+    // Canvas end - skip physics for resting items
