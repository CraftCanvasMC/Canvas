+                    }
+
+                    // remove, the fake load finished or failed, so not needed here anymore
+                    it.remove();
+                    continue;
+                }
+
+                final int distance = squaredDistance(pendingBuildX - this.lastChunkX, pendingBuildZ - this.lastChunkZ);
+                if (distance > nearestBlocker) {
