From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: Dueris <duerismc@gmail.com>
Date: Mon, 19 Oct 2026 17:02:52 -0700
Subject: [PATCH] LeafPile PR 13

Backport of https://github.com/Tuinity/LeafPile/pull/13

diff --git a/ca/spottedleaf/concurrentutil/lock/ReentrantAreaLock.java b/ca/spottedleaf/concurrentutil/lock/ReentrantAreaLock.java
index a523d6f6f508f05b7598eaf65d0c82a3e67d71d2..9a2628b7c78ca58f3dc2388913e770ccf18191e0 100644
--- a/ca/spottedleaf/concurrentutil/lock/ReentrantAreaLock.java
+++ b/ca/spottedleaf/concurrentutil/lock/ReentrantAreaLock.java
@@ -185,7 +185,7 @@ public final class ReentrantAreaLock {
         final long[] areaAffected = new long[(toSectionX - fromSectionX + 1) * (toSectionY - fromSectionY + 1)];
         int areaAffectedLen = 0;
 
-        final Node ret = new Node(this, areaAffected, currThread);
+        Node ret = new Node(this, areaAffected, currThread); // Canvas - LeafPile PR 13
 
         for (;;) {
             Node park = null;
@@ -228,8 +228,11 @@ public final class ReentrantAreaLock {
 
                 areaAffectedLen = 0;
 
-                // since we inserted, we need to drain waiters
-                ret.notifier.notifyThreadsAndBlock();
+                // Canvas start - LeafPile PR 13
+                // A contender may start waiting after this notification, so do not reuse the node.
+                ret.notifier.notifyThreads();
+                ret = new Node(this, areaAffected, currThread);
+                // Canvas end - LeafPile PR 13
             }
 
             if (park == null) {
@@ -242,6 +245,7 @@ public final class ReentrantAreaLock {
             }
 
             // failed
+            park.notifier.waitUntilReady(); // Canvas - LeafPile PR 13
         }
     }
 
