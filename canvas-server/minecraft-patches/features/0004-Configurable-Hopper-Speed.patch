From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: Ash <ashopfiremc@gmail.com>
Date: Sun, 27 Sep 2026 00:05:37 +0530
Subject: [PATCH] Configurable Hopper Speed

Adds a "transfer-cooldown" option to the Canvas per-world configuration
that controls how many ticks a hopper waits after moving items before it
can move items again.

Defaults to 1 tick so hoppers transfer items as fast as the game allows,
while 8 restores the Vanilla/Spigot behaviour. The option takes precedence
over "ticks-per.hopper-transfer" in spigot.yml and can be overridden per
world, as well as reloaded at runtime with "/canvas reload".

diff --git a/net/minecraft/world/level/block/entity/HopperBlockEntity.java b/net/minecraft/world/level/block/entity/HopperBlockEntity.java
index 963372e70d79ff8ba7361746776b937bf703a356..c27a4e42e57424100363f2ad06a8bb6be7d15012 100644
--- a/net/minecraft/world/level/block/entity/HopperBlockEntity.java
+++ b/net/minecraft/world/level/block/entity/HopperBlockEntity.java
@@ -236,7 +236,7 @@ public class HopperBlockEntity extends RandomizableContainerBlockEntity implemen
             }
 
             if (changed) {
-                entity.setCooldown(level.spigotConfig.hopperTransfer); // Spigot
+                entity.setCooldown(level.canvasConfig().hoppers.transferCooldown); // Spigot // Canvas - configurable hopper speed
                 setChanged(level, pos, state);
                 return true;
             }
@@ -301,7 +301,7 @@ public class HopperBlockEntity extends RandomizableContainerBlockEntity implemen
             }
         }
         if (foundItem && level.paperConfig().hopper.cooldownWhenFull) { // Inventory was full - cooldown
-            hopper.setCooldown(level.spigotConfig.hopperTransfer);
+            hopper.setCooldown(level.canvasConfig().hoppers.transferCooldown); // Canvas - configurable hopper speed
         }
         return false;
     }
@@ -416,7 +416,7 @@ public class HopperBlockEntity extends RandomizableContainerBlockEntity implemen
 
     private static void applyCooldown(final Hopper hopper) {
         if (hopper instanceof HopperBlockEntity blockEntity && blockEntity.getLevel() != null) {
-            blockEntity.setCooldown(blockEntity.getLevel().spigotConfig.hopperTransfer);
+            blockEntity.setCooldown(blockEntity.getLevel().canvasConfig().hoppers.transferCooldown); // Canvas - configurable hopper speed
         }
     }
 
@@ -648,7 +648,7 @@ public class HopperBlockEntity extends RandomizableContainerBlockEntity implemen
                         skipTickCount = 1;
                     }
 
-                    hopperBlockEntity.setCooldown(hopperBlockEntity.level.spigotConfig.hopperTransfer - skipTickCount); // Spigot
+                    hopperBlockEntity.setCooldown(hopperBlockEntity.level.canvasConfig().hoppers.transferCooldown - skipTickCount); // Spigot // Canvas - configurable hopper speed
                 }
 
                 container.setChanged();
