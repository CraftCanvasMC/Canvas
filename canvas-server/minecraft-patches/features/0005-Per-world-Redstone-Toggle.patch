From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: Wesley Breukers <wesley@vertcodedevelopment.com>
Date: Mon, 26 Oct 2026 19:19:13 +0200
Subject: [PATCH] Per-world Redstone Toggle

Adds `redstone.disable-signals` to the world config, off by default. When on,
every signal query in that world answers no signal, so nothing can be powered.

diff --git a/alternate/current/wire/WireHandler.java b/alternate/current/wire/WireHandler.java
index 259b301b2c8b64cb7974a235afb260e0e991af54..118b95ac6356a8d2f1ac60191c4a30792704dac6 100644
--- a/alternate/current/wire/WireHandler.java
+++ b/alternate/current/wire/WireHandler.java
@@ -689,6 +689,7 @@ public class WireHandler {
      * components.
      */
     private int getExternalPower(WireNode wire) {
+        if (level.signalsDisabled()) return POWER_MIN; // Canvas - per-world redstone toggle
         int power = POWER_MIN;
 
         for (int iDir = 0; iDir < Directions.ALL.length; iDir++) {
diff --git a/net/minecraft/world/level/Level.java b/net/minecraft/world/level/Level.java
index 4001ae117a3240d3e41b99363074a274dd672aea..0214dbc9a1727cda380faee252ec1f72904b188b 100644
--- a/net/minecraft/world/level/Level.java
+++ b/net/minecraft/world/level/Level.java
@@ -169,8 +169,17 @@ public abstract class Level implements LevelAccessor, AutoCloseable, ca.spottedl
 
     public void reloadCanvasConfig() {
         this.canvasConfig = io.canvasmc.canvas.WorldConfig.buildForLevel((ServerLevel) this, dimension);
+        this.signalsDisabled = this.canvasConfig.redstone.disableSignals; // Canvas - per-world redstone toggle
     }
     // Canvas end - Rebrand - world config
+    // Canvas start - per-world redstone toggle
+    private boolean signalsDisabled;
+
+    @Override
+    public boolean signalsDisabled() {
+        return this.signalsDisabled;
+    }
+    // Canvas end - per-world redstone toggle
 
     public static @Nullable BlockPos lastPhysicsProblem; // Spigot
     // public final Map<ServerExplosion.CacheKey, Float> explosionDensityCache = new java.util.HashMap<>(); // Paper - Optimize explosions // Folia - region threading
diff --git a/net/minecraft/world/level/SignalGetter.java b/net/minecraft/world/level/SignalGetter.java
index 25cb99e73c5be6e0471b274be60c55d73015ec06..cd3fe8fadbaaa8350f272638802ba40ff4bbfc04 100644
--- a/net/minecraft/world/level/SignalGetter.java
+++ b/net/minecraft/world/level/SignalGetter.java
@@ -11,11 +11,19 @@ import net.minecraft.world.level.redstone.Redstone;
 public interface SignalGetter extends BlockGetter {
     Direction[] DIRECTIONS = Direction.values();
 
+    // Canvas start - per-world redstone toggle
+    default boolean signalsDisabled() {
+        return false;
+    }
+
+    // Canvas end - per-world redstone toggle
     default int getDirectSignal(final BlockPos pos, final Direction direction) {
+        if (this.signalsDisabled()) return Redstone.SIGNAL_MIN; // Canvas - per-world redstone toggle
         return this.getBlockState(pos).getDirectSignal(this, pos, direction);
     }
 
     default int getDirectSignalTo(final BlockPos pos) {
+        if (this.signalsDisabled()) return Redstone.SIGNAL_MIN; // Canvas - per-world redstone toggle
         int result = 0;
         result = Math.max(result, this.getDirectSignal(pos.below(), Direction.DOWN));
         if (result >= Redstone.SIGNAL_MAX) {
@@ -47,6 +55,7 @@ public interface SignalGetter extends BlockGetter {
     }
 
     default int getControlInputSignal(final BlockPos pos, final Direction direction, final boolean onlyDiodes) {
+        if (this.signalsDisabled()) return Redstone.SIGNAL_MIN; // Canvas - per-world redstone toggle
         BlockState blockState = this.getBlockState(pos);
         if (onlyDiodes) {
             return DiodeBlock.isDiode(blockState) ? this.getDirectSignal(pos, direction) : Redstone.SIGNAL_MIN;
@@ -60,21 +69,25 @@ public interface SignalGetter extends BlockGetter {
     }
 
     default boolean hasSignal(final BlockPos pos, final Direction direction) {
+        if (this.signalsDisabled()) return false; // Canvas - per-world redstone toggle
         return this.getSignal(pos, direction) > 0;
     }
 
     default int getSignal(final BlockPos pos, final Direction direction) {
+        if (this.signalsDisabled()) return Redstone.SIGNAL_MIN; // Canvas - per-world redstone toggle
         BlockState state = this.getBlockState(pos);
         int signal = state.getSignal(this, pos, direction);
         return state.isRedstoneConductor(this, pos) ? Math.max(signal, this.getDirectSignalTo(pos)) : signal;
     }
 
     default int getBestOwnOrNeighbourSignal(final BlockPos pos) {
+        if (this.signalsDisabled()) return Redstone.SIGNAL_MIN; // Canvas - per-world redstone toggle
         BlockState blockState = this.getBlockState(pos);
         return Math.max(this.getBestNeighborSignal(pos), blockState.isSignalSource() ? blockState.getOwnSignal(this, pos) : 0);
     }
 
     default boolean hasNeighborSignal(final BlockPos blockPos) {
+        if (this.signalsDisabled()) return false; // Canvas - per-world redstone toggle
         return this.getSignal(blockPos.below(), Direction.DOWN) > 0
             || this.getSignal(blockPos.above(), Direction.UP) > 0
             || this.getSignal(blockPos.north(), Direction.NORTH) > 0
@@ -84,6 +97,7 @@ public interface SignalGetter extends BlockGetter {
     }
 
